# Database
DATABASE_URL="postgresql://career_user:career_pass@localhost:5432/career_manager?schema=public"

# NextAuth
AUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars-long"
AUTH_URL="http://localhost:3000"

# Redis (for session cache)
REDIS_URL="redis://localhost:6379"

# AI Generator (server-side only)
# Use an OpenAI-compatible provider. Never expose these values to the browser.
OPENAI_API_KEY=""
OPENAI_API_BASE="https://api.openai.com/v1"
AI_MODEL="gpt-5-mini"
