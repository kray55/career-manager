generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum BookmarkCategory {
  GOV
  LAB
  UNI
  OTHER
}

enum CheckinType {
  DAILY
  WEEKLY
  MONTHLY
}

// ──────────────────────────────────────────────
// T1-A: Multi-Tenant Foundation
// ──────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  accounts  Account[]
  sessions  Session[]
  bookmarks Bookmark[]
  notes     Note[]
  documents Document[]
}

model User {
  id              String   @id @default(cuid())
  tenantId        String
  name            String?
  email           String   @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            Role     @default(USER)
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpVerifiedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts        Account[]
  sessions        Session[]
  bookmarks       Bookmark[]
  notes           Note[]
  documents       Document[]
  skills          Skill[]
  checkins        Checkin[]

  @@index([tenantId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  tenantId          String
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([tenantId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  tenantId     String
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

// ──────────────────────────────────────────────
// T1-B: Resource Models
// ──────────────────────────────────────────────

model Bookmark {
  id          String           @id @default(cuid())
  tenantId    String
  userId      String
  url         String           @db.Text
  title       String
  description String?          @db.Text
  favicon     String?
  tags        String[]
  isFavorite  Boolean          @default(false)
  category    BookmarkCategory @default(OTHER)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
  @@index([category])
}

// ──────────────────────────────────────────────
// T4: Note Model (Sprint 2)
// ──────────────────────────────────────────────

model Note {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  title       String   @default("Untitled Note")
  content     String   @db.Text
  tags        String[]
  jobUrl      String?  @db.Text
  pinned      Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  documents   Document[]

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
  @@index([pinned])
  @@index([archived])
}

// ──────────────────────────────────────────────
// T5: Document Model (Sprint 2)
// ──────────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  title       String
  content     String   @db.Text @default("")
  type        String   @default("document")
  status      String   @default("draft")
  tags        String[]
  fileUrl     String?  @db.Text
  fileType    String   @default("")
  fileSize    Int      @default(0)
  noteId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note        Note?    @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
  @@index([type])
  @@index([status])
  @@index([noteId])
}

// ──────────────────────────────────────────────
// Skill Tracking
// ──────────────────────────────────────────────

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("")
  userId    String
  createdAt DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins Checkin[]

  @@unique([name, userId])
  @@index([userId])
  @@index([category])
}

model Checkin {
  id        String     @id @default(cuid())
  type      CheckinType
  date      DateTime   @default(now())
  notes     String     @default("")
  skillId   String
  userId    String
  createdAt DateTime   @default(now())

  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([skillId])
  @@index([date])
}
